/* ArcMap Skin – arcmap_light
   Colour tokens (an at-sign followed by a name) come from variables.qss; the icons token is the ui icon folder.
   The block is inserted at the FRONT of the application stylesheet so
   QGIS's own and other plugins' rules can still override it. */

QMainWindow, QDialog, QDockWidget, QToolBar, QMenuBar, QStatusBar {
    font-family: @font;
    font-size: @font-size;
}

QMainWindow {
    background-color: @bg-window;
}
QMainWindow::separator {
    background-color: @bg-window;
    width: 4px;
    height: 4px;
}
QMainWindow::separator:hover {
    background-color: @pressed;
}

/* ---------------------------------------------------------------- menus */
QMenuBar {
    background-color: @bg-window;
    color: @text;
    border-bottom: 1px solid @border-light;
    padding: 1px 2px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 2px;
}
QMenuBar::item:selected {
    background-color: @hover;
    border: 1px solid @border-hover;
    padding: 3px 7px;
}
QMenuBar::item:pressed {
    background-color: @pressed;
}
QMenu {
    background-color: @bg-panel;
    color: @text;
    border: 1px solid @border;
    padding: 3px 1px;
}
QMenu::item {
    padding: 4px 24px 4px 28px;
}
QMenu::item:selected {
    background-color: @hover;
    border: 1px solid @border-hover;
    padding: 3px 23px 3px 27px;
}
QMenu::item:disabled {
    color: @text-disabled;
}
QMenu::separator {
    height: 1px;
    background-color: @border-light;
    margin: 3px 6px 3px 28px;
}
QMenu::icon {
    margin-left: 5px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}
QMenu::indicator:non-exclusive:checked {
    image: url(@icons/check.svg);
}
QMenu::indicator:exclusive:checked {
    image: url(@icons/radio_dot.svg);
}

/* -------------------------------------------------------------- toolbars */
QToolBar {
    background-color: @bg-toolbar;
    border: 1px solid @border-light;
    border-radius: 2px;
    padding: 1px;
    spacing: 1px;
    margin: 1px;
}
QToolBar::handle:horizontal {
    width: 7px;
    image: url(@icons/grip_v.svg);
    margin: 2px 2px 2px 1px;
}
QToolBar::handle:vertical {
    height: 7px;
    image: url(@icons/grip_h.svg);
    margin: 1px 2px 2px 2px;
}
QToolBar::separator:horizontal {
    width: 1px;
    background-color: @border-light;
    margin: 3px 3px;
}
QToolBar::separator:vertical {
    height: 1px;
    background-color: @border-light;
    margin: 3px 3px;
}
QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
    margin: 0px;
    color: @text;
}
QToolBar QToolButton:hover {
    background-color: @hover;
    border: 1px solid @border-hover;
}
QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: @pressed;
    border: 1px solid @accent-dark;
}
QToolBar QToolButton:disabled {
    color: @text-disabled;
}
QToolButton::menu-indicator {
    image: url(@icons/arrow_down_small.svg);
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 8px;
    height: 8px;
}
QToolButton::menu-button {
    border: none;
    width: 12px;
}
QToolButton::menu-arrow {
    image: url(@icons/arrow_down_small.svg);
    width: 8px;
    height: 8px;
}
QToolBar QToolButton[popupMode="1"] {
    padding-right: 14px;
}
QToolBar QComboBox {
    min-height: 20px;
}
QToolBar QLabel {
    color: @text;
    padding: 0px 3px;
}

/* ------------------------------------------------------------- dock panes */
QDockWidget {
    color: @text-title;
    font-weight: 600;
    titlebar-close-icon: url(@icons/close.svg);
    titlebar-normal-icon: url(@icons/float.svg);
}
QDockWidget::title {
    background-color: @bg-title;
    border: 1px solid @border-light;
    border-bottom: none;
    padding: 4px 6px 4px 8px;
    text-align: left;
}
QDockWidget[arcmapActive="true"]::title {
    background-color: @bg-title-active;
    border-color: @accent;
}
QDockWidget::close-button, QDockWidget::float-button {
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 1px;
    icon-size: 12px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: @hover;
    border: 1px solid @border-hover;
}
QDockWidget > QWidget {
    font-weight: normal;
    color: @text;
}
QDockWidget[arcmapActive="true"] > QWidget#ArcMapPaneFrame,
QDockWidget > QWidget#ArcMapPaneFrame {
    border: 1px solid @border-light;
    border-top: none;
    background-color: @bg-panel;
}
QDockWidget[arcmapActive="true"] > QWidget#ArcMapPaneFrame {
    border-color: @accent;
}

/* dock tab bar (tabified panes) looks like ArcMap's bottom tabs */
QMainWindow > QTabBar::tab {
    background-color: @bg-window;
    color: @text-dim;
    border: 1px solid @border-light;
    padding: 4px 10px;
    margin-right: -1px;
}
QMainWindow > QTabBar::tab:selected {
    background-color: @bg-panel;
    color: @text;
    border-top-color: @bg-panel;
}
QMainWindow > QTabBar::tab:hover:!selected {
    background-color: @hover;
}

/* ---------------------------------------------------------- generic tabs */
QTabWidget::pane {
    border: 1px solid @border-light;
    background-color: @bg-panel;
    top: -1px;
}
QTabBar::tab {
    background-color: @bg-window;
    color: @text-dim;
    border: 1px solid @border-light;
    border-bottom: none;
    padding: 4px 10px;
    margin-right: -1px;
}
QTabBar::tab:selected {
    background-color: @bg-panel;
    color: @text;
}
QTabBar::tab:hover:!selected {
    background-color: @hover;
}

/* ----------------------------------------------------------- input widgets */
QPushButton {
    background-color: @bg-button;
    color: @text;
    border: 1px solid @border-input;
    border-radius: 2px;
    padding: 4px 12px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: @hover;
    border-color: @border-hover;
}
QPushButton:pressed {
    background-color: @pressed;
}
QPushButton:default {
    border-color: @accent;
}
QPushButton:disabled {
    color: @text-disabled;
    background-color: @bg-window;
    border-color: @border-light;
}
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QDateTimeEdit {
    background-color: @bg-panel;
    color: @text;
    border: 1px solid @border-input;
    border-radius: 2px;
    padding: 2px 4px;
    selection-background-color: @selected;
    selection-color: @text;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: @accent;
}
QLineEdit:disabled, QComboBox:disabled {
    color: @text-disabled;
    background-color: @bg-window;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox::down-arrow {
    image: url(@icons/arrow_down.svg);
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: @bg-panel;
    border: 1px solid @border;
    selection-background-color: @selected;
    selection-color: @text;
    outline: 0;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 14px;
    border: none;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(@icons/arrow_up_small.svg);
    width: 8px; height: 8px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(@icons/arrow_down_small.svg);
    width: 8px; height: 8px;
}

QCheckBox, QRadioButton {
    color: @text;
    spacing: 6px;
}
QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator {
    width: 13px;
    height: 13px;
}
QCheckBox::indicator, QGroupBox::indicator {
    border: 1px solid @border-input;
    border-radius: 2px;
    background-color: @bg-panel;
}
QCheckBox::indicator:hover, QGroupBox::indicator:hover {
    border-color: @accent;
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    image: url(@icons/check.svg);
}
QCheckBox::indicator:indeterminate {
    image: url(@icons/check_partial.svg);
}
QCheckBox::indicator:disabled {
    border-color: @border-light;
    background-color: @bg-window;
}
QRadioButton::indicator {
    border: 1px solid @border-input;
    border-radius: 7px;
    background-color: @bg-panel;
}
QRadioButton::indicator:checked {
    image: url(@icons/radio_dot.svg);
}

QGroupBox {
    border: 1px solid @border-light;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 6px;
    color: @text;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 3px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: @border-light;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    background: @bg-panel;
    border: 1px solid @border-input;
    border-radius: 6px;
}
QSlider::handle:horizontal:hover {
    border-color: @accent;
}

QProgressBar {
    border: 1px solid @border-light;
    border-radius: 2px;
    background-color: @bg-panel;
    text-align: center;
    color: @text;
}
QProgressBar::chunk {
    background-color: @accent;
}

/* ---------------------------------------------------------------- views */
QTreeView, QListView, QTableView, QTreeWidget, QListWidget, QTableWidget {
    background-color: @bg-panel;
    alternate-background-color: @bg-alternate;
    color: @text;
    border: 1px solid @border-light;
    selection-background-color: @selected;
    selection-color: @text;
    outline: 0;
}
QTreeView::item, QListView::item {
    padding: 1px 2px;
}
QTreeView::item:hover, QListView::item:hover {
    background-color: @hover;
}
QTreeView::item:selected, QListView::item:selected {
    background-color: @selected;
    color: @text;
}
QTreeView::item:selected:!active, QListView::item:selected:!active {
    background-color: @selected-inactive;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(@icons/branch_closed.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(@icons/branch_open.svg);
}
QHeaderView::section {
    background-color: @bg-header;
    color: @text;
    border: none;
    border-right: 1px solid @border-light;
    border-bottom: 1px solid @border-light;
    padding: 3px 6px;
}
QTableView QTableCornerButton::section {
    background-color: @bg-header;
    border: 1px solid @border-light;
}

/* QGIS layer tree inside the Table Of Contents */
QgsLayerTreeView {
    border: none;
    show-decoration-selected: 1;
}
QgsLayerTreeView::item {
    padding: 2px 2px;
}
QgsLayerTreeView::indicator {
    width: 13px;
    height: 13px;
}

/* ------------------------------------------------------------ scrollbars */
QScrollBar:vertical {
    background: @scrollbar-bg;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: @scrollbar-handle;
    min-height: 24px;
    margin: 2px 2px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: @scrollbar-handle-hover;
}
QScrollBar:horizontal {
    background: @scrollbar-bg;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: @scrollbar-handle;
    min-width: 24px;
    margin: 2px 2px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: @scrollbar-handle-hover;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0; height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ------------------------------------------------------------ status bar */
QStatusBar {
    background-color: @bg-statusbar;
    border-top: 1px solid @border-light;
}
QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: @tooltip-bg;
    color: @tooltip-text;
    border: 1px solid @tooltip-border;
    padding: 3px 5px;
}

/* ------------------------------------------------- ArcMap Skin own widgets */
QWidget#ArcMapTocHeader {
    background-color: @bg-panel;
    border-bottom: 1px solid @border-light;
}
QWidget#ArcMapTocHeader QToolButton {
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 1px;
}
QWidget#ArcMapTocHeader QToolButton:hover {
    background-color: @hover;
    border-color: @border-hover;
}
QWidget#ArcMapTocHeader QToolButton:checked {
    background-color: @pressed;
    border-color: @accent-dark;
}
QTreeWidget#ArcMapTocList {
    border: none;
}
QWidget#ArcMapSearchRow {
    background-color: @bg-panel;
    border-bottom: 1px solid @border-light;
}

/* map frame footer (ArcMap status bar) */
QWidget#ArcMapStatusBar {
    background-color: @bg-statusbar;
    border-top: 1px solid @border-light;
}
QWidget#ArcMapStatusBar QLabel {
    color: @text;
    padding: 0 6px;
}
QWidget#ArcMapStatusBar QLabel#ArcMapCoords {
    font-family: @font;
    min-width: 220px;
    border-left: 1px solid @border-light;
    padding-left: 8px;
}
QWidget#ArcMapStatusBar QToolButton {
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 1px;
}
QWidget#ArcMapStatusBar QToolButton:hover {
    background-color: @hover;
    border-color: @border-hover;
}
QWidget#ArcMapStatusBar QToolButton:checked {
    background-color: @pressed;
    border-color: @accent-dark;
}

/* Data View / Layout View buttons under the map */
QWidget#ArcMapViewButtons {
    background-color: @bg-window;
    border-top: 1px solid @border-light;
}
QWidget#ArcMapViewButtons QToolButton {
    border: 1px solid @border-light;
    border-top: none;
    border-radius: 0 0 2px 2px;
    padding: 1px 3px;
    background-color: @bg-window;
}
QWidget#ArcMapViewButtons QToolButton:checked {
    background-color: @bg-panel;
    border-color: @border;
}
QWidget#ArcMapViewButtons QToolButton:hover {
    background-color: @hover;
}

/* layer properties: ArcMap tabs on top */
QTabBar#ArcMapPropertyTabBar::tab {
    padding: 5px 12px;
    margin-right: -1px;
}
QTabBar#ArcMapPropertyTabBar::tab:selected {
    background-color: @bg-panel;
    border-bottom-color: @bg-panel;
    color: @text-title;
}
QWidget#ArcMapPropertyTabs {
    border-bottom: 1px solid @border-light;
}

/* attribute table: ArcMap Table window */
QgsAttributeTableView, QgsAttributeTableDialog QTableView {
    selection-background-color: @table-selected;
    selection-color: @table-selected-text;
    gridline-color: @border-light;
    alternate-background-color: @bg-alternate;
}
QgsAttributeTableView QHeaderView::section:vertical {
    background-color: @bg-header-row;
    border-right: 1px solid @border-light;
    border-bottom: 1px solid @border-light;
    padding: 0 4px;
}
QToolButton#ArcMapTableOptionsButton {
    padding: 2px 6px;
    font-weight: 600;
}

/* attribute table footer */
QWidget#ArcMapTableFooter {
    background-color: @bg-window;
    border-top: 1px solid @border-light;
}
QWidget#ArcMapTableFooter QLabel {
    color: @text;
}
QWidget#ArcMapTableFooter QLineEdit {
    max-width: 56px;
}
QFrame#ArcMapSeparator {
    color: @border-light;
    max-width: 1px;
}

QWidget#ArcMapProgress {
    background-color: @bg-panel;
    border: 1px solid @accent;
}
QLabel#ArcMapProgressTitle {
    font-weight: 600;
    color: @text-title;
}
