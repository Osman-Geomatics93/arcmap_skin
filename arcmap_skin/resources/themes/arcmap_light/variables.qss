/* ArcMap Skin palette: ArcMap 10 colours, flattened. Format: @name: value; */
@font: "Segoe UI";
@font-size: 9pt;

@bg-window: #f0f0f0;
@bg-panel: #ffffff;
@bg-toolbar: #f5f5f5;
@bg-header: #e8edf4;
@bg-title: #dfe6ef;
@bg-title-active: #c9dcf3;
@bg-statusbar: #f0f0f0;

@text: #1e1e1e;
@text-dim: #5a5a5a;
@text-disabled: #9a9a9a;
@text-title: #1f3b63;

@accent: #3b78c4;
@accent-dark: #2a5a99;
@selected: #cce4f7;
@selected-hover: #b7d7f3;
@hover: #e5f1fb;
@pressed: #c4dcf1;

@border: #a9a9a9;
@border-light: #d6d6d6;
@border-input: #9e9e9e;
@border-hover: #3b78c4;

@scrollbar-bg: #f0f0f0;
@scrollbar-handle: #c2c2c2;
@scrollbar-handle-hover: #a6a6a6;
